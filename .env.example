# AgencyOS v2 Solo — copy to .env.local
# PRD v2.0 Section 8

# Auth — team auth (NextAuth v4, DB-backed users)
# Add these to .env.local. Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here-change-this
NEXTAUTH_URL=http://localhost:3000
# Optional: used only by scripts/seed-onepixle.ts (one-time migration) — bcrypt hash of the initial admin password
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD_HASH=$2a$12$...   # output of bcrypt.hash("your-password", 12)

# Neon Database (Drizzle)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_DIRECT=  # optional, for migrations

# Cloudflare R2 (S3-compatible object storage)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=agencyos-files
CLOUDFLARE_R2_PUBLIC_URL=
# Public client-safe URL used by guest/shared pages
NEXT_PUBLIC_R2_PUBLIC_URL=https://files.agencyos.pixlesa.com

# App (set in production so metadata, OG URLs, and PWA resolve correctly — avoids broken styling on some hosts)
# NEXT_PUBLIC_APP_URL=https://your-domain.com
# NEXT_PUBLIC_APP_NAME=AgencyOS

# Mostaql scrape (optional): paste your browser Cookie header for mostaql.com while logged in
# so /api/scrape-mostaql can read your bid amount when it is hidden on the public page.
# MOSTAQL_COOKIE=

# AI Chat (admin-only) — OpenRouter: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Task due reminders (cron). Generate: openssl rand -hex 32
# Set in Vercel env; Vercel Cron calls /api/cron/task-due-reminders with Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=
#
# Mostaql background scrape worker auth (optional). If empty, falls back to CRON_SECRET.
# Used by:
# - /api/internal/mostaql-scrape-run (on-demand worker trigger)
# - /api/cron/mostaql-scrape-run (recovery cron every 5 min)
# MOSTAQL_SCRAPE_SECRET=
#
# Automatic daily Mostaql market scrape (Vercel cron at 08:00 UTC). Set to false to disable.
# MOSTAQL_AUTO_SCRAPE_ENABLED=true
